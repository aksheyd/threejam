{
  "name": "fourjs",
  "version": "0.0.1",
  "private": true,
  "description": "A game engine on Three.js for coding agents: games in TypeScript, one API as code, a CLI, and MCP tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksheyd/fourjs.git"
  },
  "homepage": "https://github.com/aksheyd/fourjs",
  "keywords": ["game-engine", "threejs", "typescript", "ai-agents", "mcp", "cli", "deterministic"],
  "type": "module",
  "bin": {
    "four": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "four": "node src/cli.ts",
    "test": "node --test",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "incur": "^0.5.1",
    "puppeteer-core": "^25.12.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
