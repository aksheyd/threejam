{
  "name": "threejam",
  "version": "0.0.4",
  "private": true,
  "description": "A 2D game engine on Three.js where coding agents prove what their games do: exact, repeatable runs, state from sim, frames from shot, as a CLI and MCP tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksheyd/threejam.git"
  },
  "homepage": "https://github.com/aksheyd/threejam",
  "bugs": "https://github.com/aksheyd/threejam/issues",
  "keywords": [
    "game-engine",
    "threejs",
    "typescript",
    "ai-agents",
    "mcp",
    "cli",
    "deterministic"
  ],
  "type": "module",
  "bin": {
    "threejam": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "threejam": "node src/cli.ts",
    "test": "node --test --test-timeout=120000 \"**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "node scripts/build.ts",
    "test:package": "node scripts/verify-package.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "incur": "0.7.0",
    "puppeteer-core": "25.12.0",
    "three": "0.186.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
